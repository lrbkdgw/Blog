{
  "name": "starlog-markdown",
  "displayName": "Markdown 语法拓展",
  "description": "直接复用博客的 Markdown 渲染组件与样式：交互展示框、折叠框、合并表格、KaTeX 公式与代码高亮，在 VS Code 内置预览中获得同款效果。",
  "version": "2.1.0",
  "publisher": "lrbkdgw",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "starlog",
    "markdown-preview-enhanced",
    "luogu",
    "tuack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lrbkdgw/Blog.git",
    "directory": "vscode_extensions/v1"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./out/preview.css"
    ],
    "markdown.previewScripts": [
      "./out/preview.js"
    ],
    "grammars": [
      {
        "scopeName": "markdown.starlog.injection",
        "path": "./syntaxes/starlog.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/starlog.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "starlog.setupMpe",
        "title": "安装 Markdown Preview Enhanced 静态兼容支持",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.setupMpeGlobal",
        "title": "安装 MPE 静态兼容支持（全局 ~/.crossnote）",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.setupMpeWorkspace",
        "title": "安装 MPE 静态兼容支持（当前工作区）",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.removeMpe",
        "title": "移除 Markdown Preview Enhanced 静态兼容支持",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.insertShowBox",
        "title": "插入交互展示框",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.insertCallout",
        "title": "插入折叠框",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.insertTuackTable",
        "title": "插入 Tuack 表格",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.insertLatexSymbol",
        "title": "插入 LaTeX 符号…",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.copyAsLuogu",
        "title": "复制为洛谷源码",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.copyAsBasic",
        "title": "复制为基本 Markdown 源码",
        "category": "Markdown 语法拓展"
      },
      {
        "command": "starlog.openCheatsheet",
        "title": "打开语法示例文档",
        "category": "Markdown 语法拓展"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "starlog.insertShowBox",
          "when": "editorLangId == markdown"
        },
        {
          "command": "starlog.insertCallout",
          "when": "editorLangId == markdown"
        },
        {
          "command": "starlog.insertTuackTable",
          "when": "editorLangId == markdown"
        },
        {
          "command": "starlog.copyAsLuogu",
          "when": "editorLangId == markdown"
        },
        {
          "command": "starlog.copyAsBasic",
          "when": "editorLangId == markdown"
        },
        {
          "command": "starlog.insertLatexSymbol",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Markdown 语法拓展",
      "properties": {
        "starlog.preview.enableGradientBackground": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "在 VS Code 内置 Markdown 预览中应用博客的渐变背景。默认关闭，关闭时使用博客的纯色背景；修改后自动刷新已打开的预览。"
        },
        "starlog.mpe.promptForSetup": {
          "type": "boolean",
          "default": false,
          "description": "检测到 Markdown Preview Enhanced 时提示安装静态兼容模式。与博客完全一致的交互渲染请使用 VS Code 内置 Markdown 预览，无需额外安装或配置。"
        }
      }
    },
    "keybindings": [
      {
        "command": "starlog.insertLatexSymbol",
        "key": "shift+up",
        "mac": "shift+up",
        "when": "editorTextFocus && editorLangId == 'markdown'"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node build.mjs",
    "test:browser": "npm run build && node --test test/browser.test.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "jsdom": "^30.1.2",
    "markdown-it": "^14.1.0",
    "morphdom": "^2.7.8",
    "playwright-core": "^1.64.0",
    "typescript": "^5.7.2"
  }
}
