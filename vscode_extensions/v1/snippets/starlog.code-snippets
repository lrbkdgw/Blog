{
  "交互展示框": {
    "prefix": ["show", "::show_begin"],
    "body": [
      "::show_begin{${1:标题}}{${2:a:Z=1[-5,5,1]}}",
      "$0",
      "::show_end",
      ""
    ],
    "description": "Markdown 语法拓展：交互展示框 ::show_begin … ::show_end"
  },
  "直角坐标系": {
    "prefix": ["uiccs", "::begin_ui-ccs"],
    "body": [
      "::begin_ui-ccs",
      "create_point:(${1:0},${2:0});",
      "create_line:(${3:-2},${4:-1}),(${5:2},${6:3}),[color=${7:red}];",
      "create_line:(${8:7*x^2+6*x+90*x^3});",
      "$0::end_ui-ccs",
      ""
    ],
    "description": "Markdown 语法拓展：可拖拽缩放的直角坐标系 ::begin_ui-ccs … ::end_ui-ccs"
  },
  "交互选择框": {
    "prefix": ["uichoose", "::begin_ui-choose"],
    "body": [
      "::begin_ui-choose[${1:meal}][${2:今天吃什么}][more ${3:1} ${4:1}]",
      "[${5:A}]",
      "${6:第一个选项内容}",
      "[${7:B}]",
      "${8:第二个选项内容}",
      "$0",
      "::end_ui-choose",
      ""
    ],
    "description": "Markdown 语法拓展：具名单选 / 多选框"
  },
  "交互下拉框": {
    "prefix": ["uiselect", "::begin_ui-select"],
    "body": [
      "::begin_ui-select[${1:fruit}][${2:search}]",
      "${3:苹果}",
      "${4:香蕉}",
      "$0",
      "::end_ui-select",
      ""
    ],
    "description": "Markdown 语法拓展：行内下拉框，可选搜索与数量限制"
  },
  "交互是否框": {
    "prefix": ["uiif", "::begin_ui-if"],
    "body": [
      "::begin_ui-if[${1:tasks}][${2:lined}]",
      "${3:第一个勾选项}",
      "::nex",
      "${4:第二个勾选项}",
      "$0",
      "::end_ui-if",
      ""
    ],
    "description": "Markdown 语法拓展：多项是 / 否勾选框"
  },
  "行内实数填空框": {
    "prefix": ["uiwrite", "::ui-write"],
    "body": "::ui-write[${1:number}][R ${2:0} ${3:1} ${4:4}]$0",
    "description": "Markdown 语法拓展：带小数位数和范围限制的行内实数输入"
  },
  "新行文本填空框": {
    "prefix": "uiwritenew",
    "body": [
      "::ui-write[${1:Name}][len ${2:2} ${3:12}][new][name ${4:姓名}]",
      "$0"
    ],
    "description": "Markdown 语法拓展：独占一行、限制长度并显示标题的文本输入"
  },
  "新行数值滑块": {
    "prefix": "uiwriterange",
    "body": [
      "::ui-write[${1:Ti}][R ${2:0} ${3:0} ${4:3}][set ${5:1}][new][name ${6:数值}][faster]",
      "$0"
    ],
    "description": "Markdown 语法拓展：独占一行的实数范围滑块"
  },
  "合并到上一行的填空框": {
    "prefix": "uiwritemerge",
    "body": "::ui-write[${1:Right}][R ${2:0} ${3:0} ${4:10}][new][name ${5:右值}][merge]$0",
    "description": "Markdown 语法拓展：与紧邻的 new 填空框共享一行"
  },
  "交互图": {
    "prefix": ["uigraph", "::begin_ui-graph"],
    "body": [
      "::begin_ui-graph[${1:dag}]",
      "point A 0 0",
      "point B 100 30",
      "A B ${2:5}",
      "$0",
      "::end_ui-graph",
      ""
    ],
    "description": "Markdown 语法拓展：有向 / 无向交互图；博客文章编辑器可调整并保存坐标"
  },
  "行内条件显示": {
    "prefix": ["uicond", "<IF:"],
    "body": "<IF:${1:1 == 1},${2:条件成立时显示}>$0",
    "description": "Markdown 语法拓展：行内公式条件显示"
  },
  "块级条件显示": {
    "prefix": ["uicondblock", "::IF"],
    "body": [
      "::IF[${1:1 == 1}]",
      "${2:条件成立时显示的完整 Markdown}",
      "$0",
      "::IF_END",
      ""
    ],
    "description": "Markdown 语法拓展：完整 Markdown 条件块"
  },
  "展示框变量 · 整数": {
    "prefix": "varz",
    "body": "${1:a}:Z=${2:0}[${3:-10},${4:10},${5:1}]",
    "description": "整数变量：默认值 [最小, 最大, 步长]"
  },
  "展示框变量 · 有理数": {
    "prefix": "varq",
    "body": "${1:b}:Q=${2:0}[${3:-10},${4:10},${5:0.5}]${6:{faster_set\\}}",
    "description": "有理数变量；加 {faster_set} 才显示滑动条"
  },
  "展示框变量 · 字符串": {
    "prefix": "vars",
    "body": "${1:name}:S=${2:星野}[${3:0},${4:12}]",
    "description": "字符串变量：[最小长度, 最大长度]"
  },
  "输出变量 show()": {
    "prefix": "show(",
    "body": "*&show(${1:a})*&",
    "description": "输出变量当前值"
  },
  "计算表达式 hs()": {
    "prefix": "hs(",
    "body": "*&hs(${1:a^2+b})*&",
    "description": "计算仅含 + - * / ^ () 与数值变量的表达式"
  },
  "向下取整 floor()": {
    "prefix": "floor(",
    "body": "&*floor(${1:a/3},${2:2})&*",
    "description": "按指定位数向下取整"
  },
  "向上取整 ceil()": {
    "prefix": "ceil(",
    "body": "&*ceil(${1:a/3},${2:2})&*",
    "description": "按指定位数向上取整"
  },
  "变量映射": {
    "prefix": "map",
    "body": "*&${1:a}:{${2:-1},${3:负一};${4:0},${5:零};${6:1},${7:正一}}*&",
    "description": "变量值到展示内容的映射"
  },
  "折叠框": {
    "prefix": [":::info", "callout"],
    "body": [
      ":::${1|info,note,tip,success,warning,error,danger|}[${2:标题}]${3:{open\\}}",
      "$0",
      ":::",
      ""
    ],
    "description": "Markdown 语法拓展：折叠框 / 提示框"
  },
  "Tuack 表格": {
    "prefix": ["::cute-table", "tuack"],
    "body": [
      "::cute-table{tuack}",
      "",
      "| ${1:表头 A} | ${2:表头 B} |",
      "| :-: | :-: |",
      "| ${3:合并两列} | < |",
      "| ${4:向上合并} | ${5:内容} |",
      "| ^ | ${6:内容} |",
      "$0"
    ],
    "description": "Markdown 语法拓展：Tuack 风格表格，< 向左合并、^ 向上合并"
  },
  "文章字体指令 set-font": {
    "prefix": ["setfont", "::set-font"],
    "body": "::set-font[${1:字体名}]",
    "description": "文章开头：强制本文正文字体（可多次出现，越早优先级越高）"
  },
  "文章代码字体指令 set-code-font": {
    "prefix": ["setcodefont", "::set-code-font"],
    "body": "::set-code-font[${1:字体名}]",
    "description": "文章开头：强制本文代码字体（可多次出现，越早优先级越高）"
  },
  "文章背景指令 set-background": {
    "prefix": ["setbackground", "::set-background"],
    "body": "::set-background[${1|0,1,2,3,4,5|}]",
    "description": "文章开头：强制阅读本文时的动态背景（0 无 · 1 樱花 · 2 粒子星链 · 3 雪花 · 4 暴雨 · 5 竹林）"
  }
}
